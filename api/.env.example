NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://aidlc:aidlc@localhost:5432/aidlc_auth?schema=public

FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
EMAIL_TOKEN_EXPIRES_IN_SECONDS=3600

ACCESS_COOKIE_NAME=aidlc_access
REFRESH_COOKIE_NAME=aidlc_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
